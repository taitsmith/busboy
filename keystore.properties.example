# Release signing config — copy this file to `keystore.properties` (which is gitignored) and fill in
# the real values. `app/build.gradle` reads it to sign release builds with the upload key; without it,
# release builds fall back to debug signing (installable for testing, NOT shippable to Play).
#
#   cp keystore.properties.example keystore.properties
#
# NEVER commit keystore.properties or the .jks keystore itself.

# Path to the keystore, relative to the repo root. Defaults to bbks.jks if omitted.
RELEASE_STORE_FILE=bbks.jks

# Keystore password.
RELEASE_STORE_PASSWORD=

# Key alias inside the keystore (the existing release key's alias is BUSBOY_K).
RELEASE_KEY_ALIAS=BUSBOY_K

# Password for that key.
RELEASE_KEY_PASSWORD=
