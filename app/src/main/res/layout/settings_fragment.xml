<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/settings_transit_system_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_transit_system"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/settings_transit_system_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_transit_system_desc"
        android:textAppearance="?attr/textAppearanceBody2"
        android:paddingBottom="16dp" />

    <RadioGroup
        android:id="@+id/agency_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/agency_ac_transit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/agency_ac_transit" />

        <RadioButton
            android:id="@+id/agency_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/agency_cta" />
    </RadioGroup>

    <TextView
        android:id="@+id/settings_active_agency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Showing AC Transit (Oakland)" />
</LinearLayout>
