<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        One theme per transit agency. MainActivity picks the matching style with
        setTheme() before super.onCreate(), so switching agencies in Settings
        re-skins the whole app. See ui/theme/AgencyTheme.kt for the mapping.

        Anything that is NOT a color belongs in Base.AppTheme so the two agency
        themes cannot drift apart.
    -->
    <style name="Base.AppTheme" parent="Theme.Material3.Light.NoActionBar" />

    <style name="AppTheme.AcTransit" parent="Base.AppTheme">
        <item name="colorPrimary">@color/ac_primary</item>
        <item name="colorOnPrimary">@color/ac_onPrimary</item>
        <item name="colorPrimaryContainer">@color/ac_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/ac_onPrimaryContainer</item>
        <item name="colorSecondary">@color/ac_secondary</item>
        <item name="colorOnSecondary">@color/ac_onSecondary</item>
        <item name="colorSecondaryContainer">@color/ac_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/ac_onSecondaryContainer</item>
        <item name="colorTertiary">@color/ac_tertiary</item>
        <item name="colorOnTertiary">@color/ac_onTertiary</item>
        <item name="colorTertiaryContainer">@color/ac_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/ac_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/ac_background</item>
        <item name="colorOnBackground">@color/ac_onBackground</item>
        <item name="colorSurface">@color/ac_surface</item>
        <item name="colorOnSurface">@color/ac_onSurface</item>
        <item name="colorSurfaceVariant">@color/ac_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/ac_onSurfaceVariant</item>
        <item name="colorOutline">@color/ac_outline</item>
        <item name="colorOnSurfaceInverse">@color/ac_inverseOnSurface</item>
    </style>

    <style name="AppTheme.Cta" parent="Base.AppTheme">
        <item name="colorPrimary">@color/cta_primary</item>
        <item name="colorOnPrimary">@color/cta_onPrimary</item>
        <item name="colorPrimaryContainer">@color/cta_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/cta_onPrimaryContainer</item>
        <item name="colorSecondary">@color/cta_secondary</item>
        <item name="colorOnSecondary">@color/cta_onSecondary</item>
        <item name="colorSecondaryContainer">@color/cta_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/cta_onSecondaryContainer</item>
        <item name="colorTertiary">@color/cta_tertiary</item>
        <item name="colorOnTertiary">@color/cta_onTertiary</item>
        <item name="colorTertiaryContainer">@color/cta_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/cta_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/cta_background</item>
        <item name="colorOnBackground">@color/cta_onBackground</item>
        <item name="colorSurface">@color/cta_surface</item>
        <item name="colorOnSurface">@color/cta_onSurface</item>
        <item name="colorSurfaceVariant">@color/cta_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/cta_onSurfaceVariant</item>
        <item name="colorOutline">@color/cta_outline</item>
        <item name="colorOnSurfaceInverse">@color/cta_inverseOnSurface</item>
    </style>

    <!-- Launch theme named by AndroidManifest, and the fallback if setTheme()
         never runs. MainActivity overrides it per the persisted agency. -->
    <style name="AppTheme" parent="AppTheme.AcTransit" />

</resources>
